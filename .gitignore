# Model checkpoints — never push to remote (large, regeneratable from training).
# Includes PyTorch checkpoint formats (.pt, .pth). Mirrors the main repo's
# (`semsimula/.gitignore`) checkpoint policy: local copies are preserved under
# each results/ folder for reproducibility, but no .pt / .pth payloads are
# tracked in this repo or pushed via Git LFS.
#
# Note: the .gitattributes patterns at lines 18, 36, 48, 64, 72, 85, 104, 109
# (`*.pt filter=lfs ...`) are kept in place but become inert because no .pt
# files are ever tracked under .gitignore. This preserves the historical
# audit trail (LFS objects already in remote storage from the v2 era under
# `notebooks/conservative_arch/{results,sarf_variant,sarf_mass_variant,
# attractor_analysis,energetic_minima,multi_seed,scaleup}/...*.pt`) without
# adding new LFS payloads going forward.
*.pt
*.pth

# macOS Finder cache files. Auto-generated by Finder whenever a directory
# is browsed; they hold view preferences (icon positions, sort order) and
# have no semantic content for the project. Must not be committed.
# Mirrors the main repo's `semsimula/.gitignore` line 37 policy.
.DS_Store

# Python bytecode cache directories. Auto-generated by the Python interpreter;
# never contain source-controlled content.
__pycache__/
*.pyc
*.pyo

# Large downloaded data files. TinyStories corpus files are downloaded at
# runtime by data_module.py and must not be tracked in the repo.
notebooks/conservative_arch/data/*.npz
notebooks/conservative_arch/data/*.parquet

# Smoke-model (random-init) conservativity results. The scientifically
# meaningful results live under results/conservativity_v21/ (trained checkpoint).
notebooks/conservative_arch/parf/results/conservativity/
